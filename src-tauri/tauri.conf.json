{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keepy Note",
  "version": "0.1.0",
  "identifier": "com.moaye.keepy-note",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keepy Note",
        "width": 440,
        "height": 720,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3RDAwMEY3QjMxRTkxOEEKUldTS2tSNno5d0RRNTlYNUY4Q1dTNXJZQlF3TGtGZVZERy93ZW1mbUQ2S2V2VDM0VGRQN3NNY3MK",
      "endpoints": [
        "https://github.com/moayed-abdalla/Keepy_Note/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "google_credentials.json"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
